# Copy to docker/.env and fill in. Read by ./manage (source .env) and by docker-compose.
# Note: ./manage hard-codes POSTGRESQL_*, DATABASE_*, DJANGO_SECRET_KEY, DJANGO_DEBUG,
# DATABASE_ENGINE, IpFilterRules and RealIpFrom, so values for those here are ignored.

# --- general ---
COMPOSE_PROJECT_NAME=fla

# --- web ---
WEB_HTTP_PORT=8080
API_URL=http://api:8080/api
WEB_BASE_HREF=/apply-for-family-order/

# --- api ---
API_HTTP_PORT=8081
PDF_SERVICE_URL=http://pdf:5001
DJANGO_LOG_LEVEL=INFO
FRONT_END=prod
# Exactly 32 characters
DATA_SECURITY_KEY=01234567890123456789012345678901
# Local user id used instead of SSO login; leave empty if OIDC is configured
OVERRIDE_USER_ID=
SITEMINDER_LOGOFF_URL=https://logontest.gov.bc.ca/clp-cgi/logoff.cgi

# --- OIDC / Keycloak (empty OIDC_RP_PROVIDER_ENDPOINT disables OIDC) ---
OIDC_RP_PROVIDER_ENDPOINT=
OIDC_RP_HOST=
OIDC_RP_CLIENT_SECRET=
OIDC_RP_KC_IDP_HINT=

# --- e-filing ---
EFILING_ENABLED=false
EFILING_STREAMS=
EFILING_EARLY_ADOPTER_STREAMS=
EFILING_HUB_API_BASE_URL=
EFILING_HUB_KEYCLOAK_BASE_URL=
EFILING_HUB_KEYCLOAK_REALM=
EFILING_HUB_KEYCLOAK_CLIENT_ID=
EFILING_HUB_KEYCLOAK_SECRET=
